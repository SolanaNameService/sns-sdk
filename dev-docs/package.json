{
  "name": "sns-developer-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Developer documentation for SNS SDKs and tools",
  "license": "MIT",
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "node scripts/generate-api.mjs",
    "api:quality:sync": "node scripts/check-generated-api-quality.mjs --sync",
    "api:quality:test": "node scripts/check-generated-api-quality.mjs --self-test",
    "api:quality": "node scripts/check-generated-api-quality.mjs",
    "api:coverage": "node scripts/check-api-coverage.mjs",
    "api:rust-links:check": "node scripts/check-rust-source-links.mjs",
    "api:rust-links:sync": "node scripts/check-rust-source-links.mjs --write",
    "api:check": "npm run api:coverage && npm run api:rust-links:check && npm run api:quality",
    "check": "npm run format:check && npm run typecheck && npm run api:check"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "serialize-javascript": "7.0.7",
    "uuid": "11.1.1"
  },
  "volta": {
    "node": "24.18.0"
  }
}
