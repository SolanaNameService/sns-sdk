{
  "name": "@bonfida/sns-react",
  "version": "4.0.0",
  "description": "A set of React hooks to interact with the Solana Name Service",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "author": "SNS",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Bonfida/sns-sdk.git",
    "directory": "react"
  },
  "homepage": "https://github.com/Bonfida/sns-sdk/blob/main/react/README.md",
  "scripts": {
    "build": "rimraf dist && rollup -c && tsc -p tsconfig.build.json && rollup -c rollup.types.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "lint": "prettier --check \"src/**/*.ts\" \"tests/**/*.{ts,tsx,mts,cts,cjs,json}\" \"scripts/**/*.mjs\" \"*.{mjs,cjs,json}\"",
    "lint:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.{ts,tsx,mts,cts,cjs,json}\" \"scripts/**/*.mjs\" \"*.{mjs,cjs,json}\"",
    "verify:package": "node ./scripts/verify-package.mjs",
    "check:package": "npm run build && npm run verify:package",
    "prepack": "npm run check:package"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@bonfida/spl-name-service": "^4.0.0",
    "@solana/web3.js": "^1.98.2",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@bonfida/prettier-config": "^1.1.0",
    "@bonfida/spl-name-service": "file:../js",
    "@rollup/plugin-typescript": "^11.1.6",
    "@solana/web3.js": "^1.98.2",
    "@tanstack/react-query": "^5.0.0",
    "@tsconfig/recommended": "^1.0.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.50",
    "@types/react": "^18.3.31",
    "@testing-library/react": "^16.3.2",
    "dotenv": "^16.5.0",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.2",
    "rollup": "^4.41.1",
    "rollup-plugin-dts": "^6.4.1",
    "ts-jest": "^29.4.11",
    "tslib": "^2.8.1",
    "typescript": "^5.4.5"
  },
  "volta": {
    "node": "20.18.0"
  },
  "prettier": "@bonfida/prettier-config"
}
